# Production frontend build. Replace the placeholder with the real public
# Turnstile site key; production builds reject Cloudflare test keys.
# Leave VITE_CONTACT_API_URL unset so production uses the same-origin
# /biosensors/api/contact route.
VITE_TURNSTILE_SITE_KEY=replace-with-real-turnstile-site-key
# Optional public Google tag ID. It is baked into the frontend at build time;
# leave blank to disable Google tracking.
VITE_GOOGLE_TAG_ID=

# Production backend runtime.
NODE_ENV=production
PRODUCTION=true
PORT=3000

# SMTP delivery. Replace every placeholder with real production credentials
# and use a TLS-enabled submission endpoint.
SMTP_HOST=replace-with-real-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-real-smtp-user
SMTP_PASS=replace-with-real-smtp-password
EMAIL_FROM=replace-with-verified-sender@example.com
EMAIL_REPORT_TO=replace-with-report-recipient@example.com

# Contact API security. Development may use Turnstile test values; production
# requires a real secret and rejects missing or test credentials.
PRODUCTION_ORIGIN=https://swissaustral.com
TURNSTILE_SECRET_KEY=replace-with-real-turnstile-secret-key
# Optional override; defaults to the hostname in PRODUCTION_ORIGIN.
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_TIMEOUT_MS=5000
# Production trusts the external proxy's sanitized client address. See README
# for the required X-Forwarded-For overwrite and host firewall boundary.
TRUST_PROXY=true
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000
