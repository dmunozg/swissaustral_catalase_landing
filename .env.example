# Frontend direct development API URL and public Turnstile key.
VITE_CONTACT_API_URL=http://127.0.0.1:3000/api/contact
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Backend runtime.
NODE_ENV=development
PORT=3000

# SMTP delivery. Configure a TLS-enabled submission endpoint.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=website@example.com
EMAIL_REPORT_TO=team@example.com

# Contact API security. Turnstile test keys are used when these are blank.
PRODUCTION_ORIGIN=http://localhost:5173
TURNSTILE_SECRET_KEY=
# Optional override; defaults to the hostname in PRODUCTION_ORIGIN.
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_TIMEOUT_MS=5000
TRUST_PROXY=false
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000
